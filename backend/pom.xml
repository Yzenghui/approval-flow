<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.5</version>
		<relativePath/>
	</parent>

	<groupId>com.approval</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>approval-flow-backend</name>
	<description>轻量级审批流组件后端</description>

	<properties>
		<java.version>21</java.version>
	</properties>

	<dependencies>
		<!-- Spring Boot Web（已包含 Jackson JSON 处理）-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- 提供@Valid、@NotBlank等注解能力 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- MyBatis-Plus -->
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-spring-boot3-starter</artifactId>
			<version>3.5.7</version>
		</dependency>

		<!-- MySQL Driver -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Sa-Token 权限认证 -->
		<dependency>
			<groupId>cn.dev33</groupId>
			<artifactId>sa-token-spring-boot3-starter</artifactId>
			<version>1.39.0</version>
		</dependency>

		<!-- Sa-Token 整合 Redis -->
		<dependency>
			<groupId>cn.dev33</groupId>
			<artifactId>sa-token-redis-jackson</artifactId>
			<version>1.39.0</version>
		</dependency>

		<!-- Spring Data Redis -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!-- RocketMQ 客户端 -->
		<dependency>
			<groupId>org.apache.rocketmq</groupId>
			<artifactId>rocketmq-client</artifactId>
			<version>4.9.7</version>
		</dependency>

		<!-- Aviator 表达式引擎 -->
		<dependency>
			<groupId>com.googlecode.aviator</groupId>
			<artifactId>aviator</artifactId>
			<version>5.4.3</version>
		</dependency>

		<!-- Lombok -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- 热加载 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- 测试 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Actuator：预置 health / info / metrics / env / beans 等运维端点，由配置决定暴露哪些；
		     除指标类外，其余端点各有独立数据源，不经注册表；
		     指标类（metrics / prometheus）输出 MeterRegistry 中的指标（仅完成注册的才会进入其中），注册来源：
		     	- JVM：Micrometer 内置
		     	- Tomcat：server.tomcat.mbeanregistry.enabled=true（注册 MBean）
		     	          + management.metrics.enable.tomcat=true（采集为指标）
		     	          （2.7+ 默认关闭 MBean 注册，两个开关缺一不可）
		     	- HikariCP：jdbc starter 自动装配
		     	- Logback：logging starter 自动装配
		     	- RocketMQ / Redis：无自动集成，需手动接入 Micrometer
		     以上指标随端点暴露后，可直接用浏览器 / curl 访问。

		     RocketMQ / Redis 亦可由 exporter 从服务端侧采集，数据不经应用，仅暴露于自身端口，
		     无法从 /actuator 访问，与手动接入的客户端视角互补，非替代关系。
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Prometheus Registry：提供 PrometheusMeterRegistry，使 MeterRegistry 中的指标
		     以 Prometheus 文本格式输出，并自动创建 /actuator/prometheus 端点
		     （classpath 有此依赖才创建，还需 management.endpoints.web.exposure.include 将其暴露）。
		     与 /actuator/metrics 数据来源相同，仅格式不同：
		     	- /actuator/metrics：JSON，人工排查（浏览器 / curl）
		     	- /actuator/prometheus：Prometheus 文本，供抓取工具拉取
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
	</dependencies>

	<build>
		<!-- 固定产物名，避免部署命令随版本号变化 -->
		<finalName>approval-flow-backend</finalName>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>

			<!-- 排除带有 manual 标签的测试，使其在常规 mvn test 中自动跳过 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<excludedGroups>manual</excludedGroups>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
