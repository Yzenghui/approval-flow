### 登录获取 Token（admin）
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "123456"
}

> {% client.global.set("admin_token", response.body.data.token); %}

### 编辑流程 - 正常修改名称和节点阈值（采购申请流程 ID=3）
PATCH http://localhost:8080/api/admin/definitions/3
Content-Type: application/json
Authorization: {{admin_token}}

{
  "name": "员工采购流程",
  "roleCode": "STAFF",
  "nodes": [
    {
      "nodeName": "主管审批",
      "nodeOrder": 1,
      "assigneeType": "RELATIVE",
      "assigneeExpr": "manager_id",
      "conditionExpr": "amount <= 500"
    },
    {
      "nodeName": "经理审批",
      "nodeOrder": 2,
      "assigneeType": "RELATIVE",
      "assigneeExpr": "manager_id.manager_id",
      "conditionExpr": "amount > 500"
    }
  ]
}

